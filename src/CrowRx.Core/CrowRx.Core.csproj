<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>9</LangVersion>
        <Nullable>enable</Nullable>

        <!-- NuGet -->
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <VersionPrefix>1.0.11</VersionPrefix>

        <RootNamespace>CrowRx</RootNamespace>
        <AssemblyName>CrowRx.Core</AssemblyName>
        <PackageId>CrowRx.Core</PackageId>

        <Title>CrowRx</Title>
        <PackageTags>unity unity-editor</PackageTags>
        <Authors>newhory</Authors>
        <Description>A core library for CrowRx. This package is intended for use with Unity3D 6.0 or newer only.		</Description>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReadmeFile>Readme.md</PackageReadmeFile>
        <Version>$(VersionPrefix)</Version>
        <AssemblyTitle>CrowRx</AssemblyTitle>
        <RepositoryType>git</RepositoryType>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <None Update="LICENSE" Pack="true" PackagePath="" />
        <None Update="Readme.md" Pack="true" PackagePath="" />
    </ItemGroup>

</Project>
